#!/command/with-contenv bashio
# ==============================================================================
# Startet den Red-Alert-Entertainment-Dienst
# ==============================================================================
declare log_level

log_level="$(bashio::config 'log_level' 'info')"
export REDALERT_LOG_LEVEL="${log_level}"

bashio::log.info "Red Alert Entertainment startet (Log-Level: ${log_level})…"
bashio::log.info "Web-UI via Ingress. REST-API via Ingress bzw. internes hassio-Netz (Port 8099, kein LAN-Mapping); externer Zugriff braucht 'Authorization: Bearer <api_token>'."

exec python3 /app/main.py
